// src/components/LeagueTabsHeader.jsx
import { useEffect, useMemo, useState } from "react";
import { useLocation, useNavigate } from "react-router-dom";
import clsx from "clsx";
import AuthIndicator from "./auth/AuthIndicator";

/* ===== constants & helpers ===== */
const LEAGUES = [
  "Premier League","La Liga","Bundesliga","Serie A","Ligue 1",
  "UEFA Champions League","Jupiler Pro League","Süper Lig","Eredivisie","Primeira Liga",
];
const SEASONS = ["2025","2024","2023","2022"];
const THEME = "#E11D48";
function tint(hex, amt){
  if(hex===undefined) hex="#111827";
  if(amt===undefined) amt=0.55;
  var c=hex.replace("#","");
  var n=parseInt(c.length===3 ? c.split("").map(function(x){return x+x;}).join("") : c,16);
  var r=(n>>16)&255, g=(n>>8)&255, b=n&255;
  function mix(v){ return Math.round(v+(255-v)*amt); }
  return "rgb("+mix(r)+", "+mix(g)+", "+mix(b)+")";
}
function getLeagueLogo(name){ return "/icons/"+String(name).replace(/\s/g,"_")+".png"; }
function safeGet(k, def){ try{ var v=localStorage.getItem(k); return v?JSON.parse(v):def; }catch(e){ return def; } }
function safeSet(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }

const TOP_LEAGUES_META = [
  { name: "Premier League", country: "Англия", tier: "Tier 1", logo: "/icons/leagues/premier_league.png" },
  { name: "La Liga", country: "Испания", tier: "Tier 1", logo: "/icons/leagues/la_liga.png" },
  { name: "Serie A", country: "Италия", tier: "Tier 1", logo: "/icons/leagues/serie_a.png" },
  { name: "Bundesliga", country: "Германия", tier: "Tier 1", logo: "/icons/leagues/bundesliga.png" },
  { name: "Ligue 1", country: "Франция", tier: "Tier 1", logo: "/icons/leagues/ligue_1.png" },
  { name: "UEFA Champions League", country: "Европа", tier: "Кубок", logo: "/icons/cups/champions_league.png" },
];

const COUNTRY_SECTIONS = [
  {
    name: "Англия",
    flag: "/icons/flags/GB.png",
    highlight: "Топ-5 лиг",
    leagues: [
      { title: "Premier League", tier: "Tier 1", info: "20 клубов", logo: "/icons/leagues/premier_league.png" },
      { title: "Championship", tier: "Tier 2", info: "24 клуба", logo: "/icons/leagues/championship.png" },
      { title: "League One", tier: "Tier 3", info: "24 клуба", logo: "/icons/leagues/league_one.png" },
    ],
    cups: ["FA Cup", "Carabao Cup"],
  },
  {
    name: "Испания",
    flag: "/icons/flags/ES.png",
    highlight: "Сильные академии",
    leagues: [
      { title: "La Liga", tier: "Tier 1", info: "20 клубов", logo: "/icons/leagues/la_liga.png" },
      { title: "Segunda División", tier: "Tier 2", info: "22 клуба", logo: "/icons/leagues/segunda.png" },
    ],
    cups: ["Copa del Rey", "Supercopa"],
  },
  {
    name: "Германия",
    flag: "/icons/flags/DE.png",
    highlight: "Высокая посещаемость",
    leagues: [
      { title: "Bundesliga", tier: "Tier 1", info: "18 клубов", logo: "/icons/leagues/bundesliga.png" },
      { title: "2. Bundesliga", tier: "Tier 2", info: "18 клубов", logo: "/icons/leagues/bundesliga2.png" },
    ],
    cups: ["DFB Pokal"],
  },
  {
    name: "Италия",
    flag: "/icons/flags/IT.png",
    highlight: "Тактическая школа",
    leagues: [
      { title: "Serie A", tier: "Tier 1", info: "20 клубов", logo: "/icons/leagues/serie_a.png" },
      { title: "Serie B", tier: "Tier 2", info: "20 клубов", logo: "/icons/leagues/serie_b.png" },
    ],
    cups: ["Coppa Italia"],
  },
];

const EURO_CUPS = [
  { title: "UEFA Champions League", subtitle: "Группы + плей-офф", logo: "/icons/cups/champions_league.png" },
  { title: "Europa League", subtitle: "Лига Европы", logo: "/icons/cups/europa_league.png" },
  { title: "Conference League", subtitle: "Третий еврокубок", logo: "/icons/cups/conference_league.png" },
];

const MAG_STATS = [
  { label: "Команд", value: "20", desc: "в высшем дивизионе" },
  { label: "Игроков", value: "560", desc: "участвуют в сезоне" },
  { label: "Матчей", value: "380", desc: "в регулярке" },
];

const MAG_FEATURES = [
  { title: "Горячие серии", excerpt: "Liverpool выиграл 8 из последних 9 матчей — смотри график формы." },
  { title: "Разбор дерби", excerpt: "Manchester vs City: xG, давление и карточки за 5 лет." },
  { title: "Инсайды", excerpt: "Молодые таланты академий: кто готов к старту следующего сезона?" },
];

const ALL_CATALOG_LEAGUES = Array.from(new Set([
  ...ALL_LEAGUES,
  "Premier League",
  "Championship",
  "League One",
  "Segunda División",
  "2. Bundesliga",
  "Serie B",
  "FA Cup",
  "Carabao Cup",
  "Copa del Rey",
  "Coppa Italia",
  "DFB Pokal",
  "Supercopa",
]));

/* ===== main header =====
   Доп. пропсы:
   - chipsMode: "full" | "none"  — показывать/не показывать ленту чипов (по умолчанию "full")
   - hideTabs:  true/false       — спрятать нижние вкладки
   - forceHideSeason: true/false — принудительно скрыть выбор сезона
*/
export default function LeagueTabsHeader(props){
  var league = props.league;
  var season = props.season;
  var onLeagueChange = props.onLeagueChange;
  var onSeasonChange = props.onSeasonChange;
  var chipsMode = props.chipsMode || "full";
  var hideTabs = !!props.hideTabs;
  var forceHideSeason = !!props.forceHideSeason;

  var navigate = useNavigate();
  var location = useLocation();

  // активная вкладка
  var active =
    location.pathname.indexOf("/matches-v3") >= 0 ? "results" :
    location.pathname.indexOf("/schedule")   >= 0 ? "calendar" :
    location.pathname.indexOf("/best-picks") >= 0 ? "picks" :
    location.pathname.indexOf("/subscriptions") >= 0 ? "subscriptions" :
    "table";

  // прячем сезон на страницах топ-скоро́ров/ассистов ИЛИ если просят принудительно
  var hideSeasonAuto = /\/top-(scorers|assists)/i.test(location.pathname);
  var hideSeason = forceHideSeason || hideSeasonAuto;

  var bg = "linear-gradient(90deg, "+THEME+" 0%, "+tint(THEME,0.7)+" 60%, "+tint(THEME,0.85)+" 100%)";

  // сезоны
  var [openSeason, setOpenSeason] = useState(false);
  useEffect(function(){
    function onKey(e){ if(e.key==="Escape") setOpenSeason(false); }
    window.addEventListener("keydown", onKey);
    return function(){ window.removeEventListener("keydown", onKey); };
  }, []);

  // «все лиги»
  var [openAll, setOpenAll] = useState(false);

  useEffect(function(){
    var recent = safeGet("recent_leagues", []);
    var next = [league].concat(recent.filter(function(x){ return x !== league; })).slice(0,8);
    safeSet("recent_leagues", next);
  }, [league]);

  function emitLeagueChange(n){ if(typeof onLeagueChange==="function") onLeagueChange(n); }
  function emitSeasonChange(s){ if(typeof onSeasonChange==="function") onSeasonChange(s); }

  function renderTab(tab, label){
    var isActive = active === tab;
    var path;
    if(tab==="results") path="matches-v3";
    else if(tab==="calendar") path="schedule";
    else if(tab==="picks") path="best-picks";
    else if(tab==="subscriptions") path="subscriptions";
    else path="table";

    var href = path==="subscriptions" ? ("/"+path) : ("/"+path+"?league="+encodeURIComponent(league)+"&season="+season);

    return (
      <button
        key={tab}
        onClick={function(){ navigate(href); }}
        className={clsx(
          "px-4 py-2 border-b-2 text-sm font-medium",
          isActive ? "text-red-600 border-red-600"
                   : "text-gray-600 border-transparent hover:text-black hover:border-black/20 transition-colors"
        )}
      >
        {label}
      </button>
    );
  }

  return (
    <div className="sticky top-0 z-20">
      {/* верхняя плашка */}
      <div style={{ background: bg }} className="shadow-sm">
        <div className="mx-auto max-w-5xl px-4 py-3">
          <div className="flex items-center justify-between gap-4">
            <div className="flex items-center gap-3 text-white">
              <div className="h-11 w-11 rounded-xl bg-white/90 p-1 grid place-items-center">
                <img
                  src={getLeagueLogo(league)}
                  alt={league}
                  className="h-9 w-9 object-contain"
                  onError={function(e){ e.currentTarget.onerror=null; e.currentTarget.src="/icons/default_league.png"; }}
                />
              </div>
              <div className="min-w-0">
                <div className="text-[11px] opacity-80">Текущая лига</div>
                <h1 className="truncate text-xl font-bold tracking-tight">{league}</h1>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <button
                onClick={function(){ setOpenAll(true); }}
                className="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/20 px-3 py-1.5 text-sm text-white hover:bg-white/30"
              >
                <span className="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white text-rose-500">🌍</span>
                <span>Каталог</span>
              </button>
              <AuthIndicator />
            </div>
          </div>

          {/* галерея топ-лиг и переход в каталог */}
          {chipsMode !== "none" && (
            <div className="mt-4 space-y-3">
              <TopGallery
                activeLeague={league}
                onSelect={emitLeagueChange}
                onOpenCatalog={function(){ setOpenAll(true); }}
              />
              <p className="text-xs text-white/80 sm:text-sm">
                Выберите популярный турнир или откройте подробный каталог по странам и кубкам.
              </p>
            </div>
          )}
        </div>
      </div>

      {/* вкладки и сезоны (сезон можно скрыть forceHideSeason) */}
      {!hideTabs && (
        <div className="bg-white border-b shadow-sm">
          <div className="mx-auto max-w-5xl px-4">
            <div className="flex items-center justify-between gap-3">
              <div className="flex gap-4">
                {renderTab("overview","Обзор")}
                {renderTab("results","Результаты")}
                {renderTab("calendar","Календарь")}
                {renderTab("table","Таблица")}
                {renderTab("picks","Подборки")}
                {renderTab("subscriptions","Подписки")}
              </div>

              {!hideSeason && (
                <div className="relative">
                  <button
                    onClick={function(){ setOpenSeason(!openSeason); }}
                    className="inline-flex items-center gap-2 h-8 px-3 rounded-lg border border-gray-300 text-sm bg-white hover:bg-gray-50"
                    title="Выбрать сезон"
                  >
                    <span>{season}</span>
                    <span className="text-gray-400">▾</span>
                  </button>
                  {openSeason && (
                    <div className="absolute right-0 top-10 z-20 w-36 rounded-lg border border-gray-200 bg-white shadow-md">
                      {SEASONS.map(function(s){
                        var isCur = season===s;
                        return (
                          <button
                            key={s}
                            onClick={function(){ emitSeasonChange(s); setOpenSeason(false); }}
                            className={clsx("w-full text-left px-3 py-2 text-sm hover:bg-gray-50", isCur && "bg-gray-100 font-semibold")}
                          >
                            {s}
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {openAll && (
        <MegaCatalogModal
          current={league}
          onClose={function(){ setOpenAll(false); }}
          onSelect={emitLeagueChange}
        />
      )}
    </div>
  );
}

/* ======= Модалка «Все лиги» ======= */
function TopGallery({ activeLeague, onSelect, onOpenCatalog }) {
  return (
    <div className="flex flex-wrap items-center justify-between gap-3">
      <div className="flex items-center gap-2 overflow-x-auto rounded-2xl bg-white/85 px-3 py-2 shadow-inner">
        {TOP_LEAGUES_META.map((league) => {
          const isActive = league.name === activeLeague;
          const cls =
            "flex items-center gap-2 rounded-full px-3 py-1.5 text-sm transition " +
            (isActive ? "bg-rose-500 text-white shadow" : "bg-white text-slate-600 border border-slate-200");
          return (
            <button
              key={league.name}
              onClick={() => onSelect(league.name)}
              className={cls}
            >
              <span className="inline-flex h-6 w-6 items-center justify-center rounded-full bg-white">
                <img
                  src={league.logo}
                  alt={league.name}
                  className="h-4 w-4 object-contain"
                  onError={(e) => {
                    e.currentTarget.style.display = "none";
                  }}
                />
              </span>
              <span>{league.name}</span>
            </button>
          );
        })}
      </div>
      <button
        onClick={onOpenCatalog}
        className="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100"
      >
        <span className="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white">≡</span>
        <span>Каталог лиг</span>
      </button>
    </div>
  );
}

function TopLeagueCardsGrid({ activeLeague, onSelect }) {
  return (
    <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {TOP_LEAGUES_META.map((league) => {
        const isActive = league.name === activeLeague;
        return (
          <div
            key={league.name}
            className={clsx(
              "flex items-center gap-3 rounded-2xl border px-4 py-4 shadow-sm",
              isActive ? "border-rose-500 bg-rose-50" : "border-slate-200 bg-white"
            )}
          >
            <span className="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-50">
              <img
                src={league.logo}
                alt={league.name}
                className="h-8 w-8 object-contain"
                onError={(e) => {
                  e.currentTarget.style.display = "none";
                }}
              />
            </span>
            <div className="flex-1">
              <div className="text-base font-semibold text-slate-900">{league.name}</div>
              <div className="text-xs uppercase tracking-wide text-slate-500">{league.country} · {league.tier}</div>
            </div>
            <button
              className="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600"
              onClick={() => onSelect(league.name)}
            >
              Перейти →
            </button>
          </div>
        );
      })}
    </div>
  );
}

function CountryCard({ country, onSelect }) {
  return (
    <div className="flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white px-5 py-5 shadow-sm">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <span className="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100">
            <img
              src={country.flag}
              alt={country.name}
              className="h-8 w-8 object-contain"
              onError={(e) => {
                e.currentTarget.style.display = "none";
              }}
            />
          </span>
          <div>
            <div className="text-lg font-semibold text-slate-900">{country.name}</div>
            <div className="text-xs text-slate-500">{country.highlight}</div>
          </div>
        </div>
        <button
          className="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600"
          onClick={() => onSelect(country.leagues[0]?.title || country.name)}
        >
          Перейти →
        </button>
      </div>
      <div className="space-y-3">
        {country.leagues.map((league) => (
          <div key={league.title} className="flex items-center gap-3 rounded-2xl border border-slate-100 bg-slate-50 px-3 py-3">
            <span className="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white">
              <img
                src={league.logo}
                alt={league.title}
                className="h-6 w-6 object-contain"
                onError={(e) => {
                  e.currentTarget.style.display = "none";
                }}
              />
            </span>
            <div className="flex-1">
              <div className="text-sm font-semibold text-slate-800">{league.title}</div>
              <div className="text-xs uppercase tracking-wide text-slate-500">{league.tier}</div>
            </div>
            <div className="text-xs text-slate-500">{league.info}</div>
            <button
              className="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600"
              onClick={() => onSelect(league.title)}
            >
              Выбрать
            </button>
          </div>
        ))}
      </div>
      <div className="flex flex-wrap gap-2 text-xs text-slate-500">
        {country.cups.map((cup) => (
          <button
            key={cup}
            className="rounded-full border border-slate-200 px-3 py-1 hover:bg-slate-100"
            onClick={() => onSelect(cup)}
          >
            {cup}
          </button>
        ))}
      </div>
    </div>
  );
}

function CountryCatalogue({ onSelect }) {
  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <span className="text-sm font-semibold text-slate-800">Каталог по странам</span>
        <span className="text-xs text-slate-500">Высшие лиги и национальные кубки</span>
      </div>
      <div className="grid gap-4 lg:grid-cols-2">
        {COUNTRY_SECTIONS.map((country) => (
          <CountryCard key={country.name} country={country} onSelect={onSelect} />
        ))}
      </div>
    </div>
  );
}

function EuroCupsGrid({ onSelect }) {
  return (
    <div className="space-y-4">
      <div className="text-sm font-semibold text-slate-800">Международные кубки</div>
      <div className="grid gap-3 sm:grid-cols-3">
        {EURO_CUPS.map((cup) => (
          <div
            key={cup.title}
            className="flex flex-col items-center gap-3 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700 px-4 py-5 text-white shadow-lg"
          >
            <span className="inline-flex h-14 w-14 items-center justify-center rounded-full bg-white/20">
              <img
                src={cup.logo}
                alt={cup.title}
                className="h-10 w-10 object-contain"
                onError={(e) => {
                  e.currentTarget.style.display = "none";
                }}
              />
            </span>
            <span className="text-center text-sm font-semibold">{cup.title}</span>
            <span className="text-xs text-white/80">{cup.subtitle}</span>
            <button
              className="rounded-full bg-white/20 px-3 py-1 text-xs uppercase tracking-wide text-white/90"
              onClick={() => onSelect(cup.title)}
            >
              Перейти
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}

function MagazinePreview() {
  return (
    <div className="rounded-3xl bg-white shadow-lg">
      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 px-6 py-5">
        <div>
          <div className="text-xs uppercase tracking-wide text-slate-400">Журнал лиги</div>
          <div className="text-2xl font-bold text-slate-900">Аналитика и тенденции</div>
        </div>
        <span className="inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white">
          ✦ Обновления
        </span>
      </div>
      <div className="grid gap-6 px-6 py-6 lg:grid-cols-[320px_minmax(0,1fr)]">
        <aside className="space-y-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">Статистика</div>
          <div className="space-y-3">
            {MAG_STATS.map((item) => (
              <div key={item.label} className="rounded-2xl bg-slate-50 px-4 py-3">
                <div className="text-xs uppercase tracking-wide text-slate-500">{item.label}</div>
                <div className="text-2xl font-bold text-slate-900">{item.value}</div>
                <div className="text-xs text-slate-500">{item.desc}</div>
              </div>
            ))}
          </div>
          <div className="rounded-2xl bg-gradient-to-r from-rose-500 to-rose-400 px-4 py-5 text-white shadow">
            <div className="text-xs uppercase tracking-wide text-white/80">Следующий тур</div>
            <div className="mt-2 text-lg font-semibold">Arsenal vs Liverpool</div>
            <div className="text-sm text-white/80">Суббота, 21:45</div>
          </div>
        </aside>
        <div className="space-y-6">
          <div className="rounded-3xl bg-white/90 px-6 py-5 shadow-inner">
            <div className="text-xs uppercase tracking-wide text-slate-500">Главная история</div>
            <div className="mt-2 text-2xl font-bold text-slate-900">Дерби Манчестера: тактика, тренды и ключевые игроки</div>
            <p className="mt-3 text-sm text-slate-600">
              Глубокий анализ последнего матча: давление в средней зоне, карта ударов, влияние замен и тенденции по xG.
            </p>
          </div>
          <div className="grid gap-4 sm:grid-cols-3">
            {MAG_FEATURES.map((card) => (
              <div key={card.title} className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="text-sm font-semibold text-slate-800">{card.title}</div>
                <p className="mt-2 text-sm text-slate-600">{card.excerpt}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

function MegaCatalogModal({ current, onClose, onSelect }) {
  const [search, setSearch] = useState("");

  useEffect(() => {
    setSearch("");
  }, []);

  const searchResults = useMemo(() => {
    const term = search.trim().toLowerCase();
    if (!term) return [];
    return ALL_CATALOG_LEAGUES.filter((item) => item.toLowerCase().includes(term));
  }, [search]);

  const handleSelect = (value) => {
    if (!value) return;
    onSelect(value);
  };

  const hasQuery = search.trim().length > 0;

  return (
    <div className="fixed inset-0 z-50">
      <div className="absolute inset-0 bg-black/40" onClick={onClose} />
      <div className="absolute left-1/2 top-16 h-[min(85vh,720px)] w-[min(960px,92vw)] -translate-x-1/2 overflow-hidden rounded-3xl bg-white shadow-2xl">
        <div className="flex items-start justify-between border-b border-slate-100 px-6 py-4">
          <div>
            <h2 className="text-xl font-semibold text-slate-900">Каталог лиг</h2>
            <p className="text-sm text-slate-500">Быстрый доступ к топовым турнирам, странам и международным кубкам</p>
          </div>
          <button
            className="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-lg text-slate-500 hover:bg-slate-100"
            onClick={onClose}
            aria-label="Закрыть"
          >
            ×
          </button>
        </div>

        <div className="border-b border-slate-100 px-6 py-4">
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Поиск лиги или кубка"
            className="w-full rounded-xl border border-slate-200 px-4 py-2 text-sm shadow-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-100"
          />
        </div>

        <div className="h-[calc(100%-120px)] overflow-y-auto px-6 py-6 space-y-8">
          {hasQuery ? (
            <div>
              <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">Результаты поиска</div>
              <div className="mt-3 space-y-2">
                {searchResults.length ? (
                  searchResults.map((item) => (
                    <button
                      key={item}
                      className="w-full rounded-xl border border-slate-200 bg-white px-4 py-2 text-left text-sm text-slate-600 hover:bg-slate-50"
                      onClick={() => handleSelect(item)}
                    >
                      {item}
                    </button>
                  ))
                ) : (
                  <div className="rounded-xl border border-slate-200 bg-white px-4 py-6 text-sm text-slate-500">
                    Совпадений не найдено
                  </div>
                )}
              </div>
            </div>
          ) : (
            <>
              <div>
                <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">Топ турниры</div>
                <div className="mt-3">
                  <TopLeagueCardsGrid activeLeague={current} onSelect={handleSelect} />
                </div>
              </div>

              <CountryCatalogue onSelect={handleSelect} />

              <EuroCupsGrid onSelect={handleSelect} />

              <MagazinePreview />
            </>
          )}
        </div>
      </div>
    </div>
  );
}
