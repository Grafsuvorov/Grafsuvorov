# OHD source MR project: namespace/project from the GitLab URL.
OHD_ANALYST_GITLAB_PROJECT=

# Separate OHD GitLab: API URL with /api/v4, actual token value, namespace/project paths.
OHD_GITLAB_API_URL=
OHD_GITLAB_TOKEN=
OHD_GITLAB_SSL_VERIFY=true
OHD_DBT_GITLAB_PROJECT=
OHD_ANALYST_GITLAB_TOKEN=
OHD_DBT_GITLAB_TOKEN=

# Dedicated YouTrack token for OHD (required for OHD issue creation).
OHD_YOUTRACK_TOKEN=
