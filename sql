with new as (  select * from
						( select 
								row_number() over (partition by bukrs, belnr,gjahr,buzei order by file_num desc, row_num desc) r, s.*
						  from stg.ral_zbw1595m_odata_srv s
						  where sap_pointer = '{sap_pointer}'
						) a 
				   where r=1 )
insert into  ods.accounting_documents(
		unit_balance_code,
		fiscal_year,
		accounting_document_code,
		dt_posting,
		debit_or_credit,
		account_type,
		general_ledger_account_code,
		document_currency_amount,
		local_currency_amount,
		second_local_currency_amount,
		valuation_difference_second_local_currency_amount,
		document_currency_code,
		local_currency_code,
		second_local_currency_code,
		plant_code,
		contract_number,
		customer_code,
		supplier_code,
		accounting_document_type,
		accounting_document_status_code,
		posting_period,
		accounting_document_header_text,
		reverse_document_code,
		reference_document_number,
		clearing_document_code,
		dt_clearing,
		position_line_item,
		position_line_item_type_code,
		tax_code,
		invoice_document_code,
		fiscal_year_of_relevant_invoice,
		position_number_of_relevant_invoice,
		position_line_item_text,
		special_general_ledger_indicator,
		dt_baseline_due_date_calculation,
		terms_of_payment_code,
		assignment_number,
		is_red_reverse_posting,
		dt_accounting_document,
		dt_tax_reporting,
		reverse_document_fiscal_year,
		dttm_accounting_document_created,
		accounting_document_created_by,
		transaction_code,
		exchange_rate,
		dt_currency_translation,
		reference_procedure,
		reference_object_key,
		reason_for_reversal,
		reference_key_internal_for_document_header_1,
		reference_key_internal_for_document_header_2,
		reference_key_for_line_item_1,
		reference_key_for_line_item_2,
		reference_key_for_line_item_3,
		material_code,
		cost_center_code,
		co_order_number,
		wbs_element_code,
		funds_center_code,
		financial_position_internal_code,
		transaction_type_general_ledger,
		asset_main_number,
		asset_subnumber,
		asset_transaction_type,
		settlement_period,
		payee_or_payer_code,
		is_blocked_by_payment_program,
		purchase_document_code,
		purchase_document_position_line_item_code,
		earmarked_document_code,
		earmarked_document_position_line_item_code,
		fund_code,
		is_reversed_document,
		dt_accounting_document_provisionally_registered,
		accounting_document_provisionally_registered_by_code,
		is_active,
		is_deleted,
		dttm_from,
		dttm_to,
		sap_pointer,
		dttm_inserted,
		dttm_updated,
		job_name,
		deleted_flag
	) 
	select
		rti.bukrs as unit_balance_code,
		rti.gjahr::numeric as fiscal_year,
		rti.belnr as accounting_document_code,
		rti.budat::date as dt_posting,
		rti.shkzg as debit_or_credit,
		rti.koart as account_type,
		rti.hkont as general_ledger_account_code,
		rti.wrbtr::numeric as document_currency_amount,	
		rti.dmbtr::numeric as local_currency_amount,
		rti.dmbe2::numeric as second_local_currency_amount,
		rti.bdif2::numeric as valuation_difference_second_local_currency_amount,
		rti.waers as document_currency_code,
		rti.hwaer as local_currency_code,
		rti.hwae2 as second_local_currency_code,
		tech_etl.util_text_to_null_validation(rti.werks) as plant_code,
		tech_etl.util_text_to_null_validation(rti.vertn) as contract_number,
		tech_etl.util_text_to_null_validation(rti.kunnr) as customer_code,
		tech_etl.util_text_to_null_validation(rti.lifnr) as supplier_code,
		rti.blart as accounting_document_type,
		tech_etl.util_text_to_null_validation(rti.bstat) as accounting_document_status_code,
		rti.monat as posting_period,
		tech_etl.util_text_to_null_validation(rti.bktxt) as accounting_document_header_text,
		tech_etl.util_text_to_null_validation(rti.stblg) as reverse_document_code,
		tech_etl.util_text_to_null_validation(rti.xblnr) as reference_document_number,
		tech_etl.util_text_to_null_validation(rti.augbl) as clearing_document_code,
		tech_etl.util_text_to_date_validation(rti.augdt) as dt_clearing,
		rti.buzei::numeric as position_line_item,
		tech_etl.util_text_to_null_validation(rti.buzid) as position_line_item_type_code,
		tech_etl.util_text_to_null_validation(rti.mwskz) as tax_code,
		tech_etl.util_text_to_null_validation(rti.rebzg) as invoice_document_code,
		case
			when rti.rebzj = '0000'
		   	then null
			else rti.rebzj::numeric
		end as fiscal_year_of_relevant_invoice,
		case
			when rti.rebzz = '000'
	   		then null
			else rti.rebzz::numeric
		end as position_number_of_relevant_invoice,
		tech_etl.util_text_to_null_validation(rti.sgtxt) as position_line_item_text,
		tech_etl.util_text_to_null_validation(rti.umskz) as special_general_ledger_indicator,
		tech_etl.util_text_to_date_validation(rti.zfbdt)
			 as dt_baseline_due_date_calculation,
		tech_etl.util_text_to_null_validation(rti.zterm) as terms_of_payment_code,
		tech_etl.util_text_to_null_validation(rti.zuonr) as assignment_number,
		tech_etl.util_text_to_null_validation(rti.xnegp) as is_red_reverse_posting,
		rti.bldat::date as dt_accounting_document,
		tech_etl.util_text_to_date_validation(rti.vatdate)  as dt_tax_reporting,
		case
			when rti.stjah = '0000' or rti.stjah = '0'
	   		then null
			else rti.stjah::numeric
		end as reverse_document_fiscal_year,
		(rti.cpudt::date || ' ' || to_timestamp(rti.cputm,'PTHH24:MI:SS')::time)::timestamp as dttm_accounting_document_created,
		tech_etl.util_text_to_null_validation(rti.usnam) as accounting_document_created_by,
		tech_etl.util_text_to_null_validation(rti.tcode) as transaction_code,
		rti.kursf::numeric as exchange_rate,
		case
			when rti.wwert = '00000000'
   			then null::date
			else rti.wwert::date
		end as dt_currency_translation,
		tech_etl.util_text_to_null_validation(rti.awtyp) as reference_procedure,
		tech_etl.util_text_to_null_validation(rti.awkey) as reference_object_key,
		tech_etl.util_text_to_null_validation(rti.stgrd) as reason_for_reversal,
		tech_etl.util_text_to_null_validation(rti.xref1_hd) as reference_key_internal_for_document_header_1,
		tech_etl.util_text_to_null_validation(rti.xref2_hd) as reference_key_internal_for_document_header_2,
		tech_etl.util_text_to_null_validation(rti.xref1) as reference_key_for_line_item_1,
		tech_etl.util_text_to_null_validation(rti.xref2) as reference_key_for_line_item_2,
		tech_etl.util_text_to_null_validation(rti.xref3) as reference_key_for_line_item_3,
		tech_etl.util_text_to_null_validation(rti.matnr) as material_code,
		tech_etl.util_text_to_null_validation(rti.kostl) as cost_center_code,
		tech_etl.util_text_to_null_validation(rti.aufnr) as co_order_number,
		case
			when rti.projk = '00000000'
    		then null
			else tech_etl.util_text_to_null_validation(rti.projk)
		end as wbs_element_code,
		tech_etl.util_text_to_null_validation(rti.fistl) as funds_center_code,
		tech_etl.util_text_to_null_validation(rti.fipos) as financial_position_internal_code,
		tech_etl.util_text_to_null_validation(rti.vorgn) as transaction_type_general_ledger,
		tech_etl.util_text_to_null_validation(rti.anln1) as asset_main_number,
		tech_etl.util_text_to_null_validation(rti.anln2) as asset_subnumber,
		tech_etl.util_text_to_null_validation(rti.anbwa) as asset_transaction_type,
		tech_etl.util_text_to_null_validation((substring( rti.abper,2,7))) as settlement_period,
		tech_etl.util_text_to_null_validation(rti.empfb) as payee_or_payer_code,
		tech_etl.util_text_to_null_validation(rti.xpypr) as is_blocked_by_payment_program,
		tech_etl.util_text_to_null_validation(rti.ebeln) as purchase_document_code,
		tech_etl.util_text_to_null_validation(rti.ebelp) as purchase_document_position_line_item_code,
		tech_etl.util_text_to_null_validation(rti.kblnr) as earmarked_document_code,
		tech_etl.util_text_to_null_validation(rti.kblpos) as earmarked_document_position_line_item_code,
		tech_etl.util_text_to_null_validation(rti.geber) as fund_code,
		tech_etl.util_text_to_null_validation(rti.xreversal) as is_reversed_document,
		case
        	when nullif(rti.ppdat, '00000000')is null then null
        	else (rti.ppdat::date || ' ' || to_timestamp(rti.pptme,'PTHH24:MI:SS')::time)::timestamp end as dt_accounting_document_provisionally_registered,
		tech_etl.util_text_to_null_validation(rti.ppnam) as accounting_document_provisionally_registered_by_code,		
		true as is_active,
		false as is_deleted,
		now() as dttm_from, 
		cast('2099-12-31 23:59:59.000' as timestamp) as dttm_to,
		sap_pointer as sap_pointer,
		now() as dttm_inserted,
		now() as dttm_updated,
		'airflow' as job_name,
		false as deleted_flag
	from new rti;
