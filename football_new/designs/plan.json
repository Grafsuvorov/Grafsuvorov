explain(verbose, format json)
select
    base.invoice_code, -- MM.000248
    base.fiscal_year, -- MM.000250
    base.unit_balance_code, -- MM.000251
    base.purchase_document_type_code                                                                                                                               as invoice_type_code, -- MM.000252
    base.dt_purchase_document                                                                                                                                      as dt_invoice, -- MM.000253
    base.dt_posting                                                                                                                                                as dt_invoice_posting, -- MM.000254
    base.invoice_currency_code, -- MM.000258
    base.payee_alternative_code                                                                                                                                    as counterparty_code, -- MM.000269
    base.invoice_position_line_item_text                                                                                                                           as invoice_position_line_item_text_description, -- MM.000274
    case
        when mseg.material_movement_document_header_text is not null and mseg.material_movement_document_header_text <> 'FICT' then mseg.material_movement_document_header_text
        when (mseg.material_movement_document_header_text is null or mseg.material_movement_document_header_text = 'FICT') and base.customs_declaration_number is not null then base.customs_declaration_number
        when mseg.batch_code ~ '^\d+(\.\d+)?$' = true then for_300.material_movement_document_header_text -- Партия состоит только из цифр
        when mseg.batch_code ~ '^\d+(\.\d+)?$' = false then zgtd.customs_declaration_external_number
    end                                                                                                                                                            as customs_declaration_number, -- MM.000300
    base.invoice_of_supplier_agent_code                                                                                                                            as agent_invoice_number, -- MM.000303
    base.creditor_agent_code                                                                                                                                       as agent_code, -- MM.000304
    bkpf.accounting_document_code, -- MM.000249
    case
        when bkpf_2.reference_document_number like '#%' then bseg.position_line_item_text
        else bkpf_2.reference_document_number
    end                                                                                                                                                            as supplier_invoice_number, -- MM.000255
    bkpf_2.reference_key_internal_for_document_header_1                                                                                                            as minor_adjusted_external_invoice_number, -- MM.000256
    bkpf_2.reference_key_internal_for_document_header_2                                                                                                            as major_adjusted_external_invoice_number, -- MM.000257
    base.invoice_position_line_item_code, -- MM.000259
    base.assignment_code                                                                                                                                           as invoice_position_line_item_assignment_code, -- MM.000260
    base.debit_or_credit_code, -- MM.000261
    base.reference_document_number                                                                                                                                 as bill_or_receipt_document_number, -- MM.000276
    base.purchase_document_code, -- MM.000279
    base.purchase_document_position_line_item_code, -- MM.000280
    base.plant_code, -- MM.000281
    base.material_code, -- MM.000282
    base.valuation_type_code, -- MM.000289
    rbco.general_ledger_account_code                                                                                                                               as expense_general_ledger_account_code, -- MM.000264
    coalesce(rbco.vat_code, base.vat_tax_code)                                                                                                                     as tax_code, -- MM.000285
    rbco.cost_center_code, -- MM.000293
    rbco.order_code, -- MM.000295
    coalesce(rbco.wbs_element_code, ekkn.wbs_element_code)                                                                                                         as wbs_element_code, -- MM.000297
    case
        when
            coalesce(ekpo_1.expense_assignment_type_code, ekpo_2.expense_assignment_type_code, ekpo_3.expense_assignment_type_code) in
            (select range_low_value from knttp_params)
            then rbco.assignment_position_document_currency_amount
        else 0
    end                                                                                                                                                            as transportation_and_procurement_position_cost_amount, -- MM.000299
    bseg.general_ledger_account_code                                                                                                                               as contractor_general_ledger_account_code, -- MM.000262
    glas.general_ledger_account_code                                                                                                                               as temporary_general_ledger_account_code, -- MM.000263
    case when ekbe.debit_or_credit_code = 'S' then ekbe.local_currency_amount else -ekbe.local_currency_amount end                                                 as local_currency_amount, -- MM.000265
    case when ekbe.debit_or_credit_code = 'S' then ekbe.document_currency_amount else -ekbe.document_currency_amount end                                           as document_currency_amount, -- MM.000266
    case when ekbe.debit_or_credit_code = 'S' then ekbe.quantity else -ekbe.quantity end                                                                           as material_quantity, -- MM.000284
    case when ekbe.debit_or_credit_code = 'S' then ekbe.general_ledger_account_clearing_amount else -ekbe.general_ledger_account_clearing_amount end               as general_ledger_account_clearing_amount, -- MM.000310
    ekbe.reference_document_code, -- MM.000311
    ekbe.reference_document_fiscal_year, -- MM.000312
    ekbe.reference_document_position_code                                                                                                                          as reference_document_position_line_item_code, -- MM.000313
    coalesce(bseg_2.tax_classification_code, bseg_3.tax_classification_code)                                                                                       as tax_classification_code, -- MM.000309
    counter.counterparty_full_name                                                                                                                                 as counterparty_name, -- MM.000270
    counter.counterparty_tin_code, -- MM.000271
    coalesce(ekko_1_1.supplier_code, ekko_1_2.supplier_code, ekko_1_3.supplier_code)                                                                               as supplier_code, -- MM.000272 -- ekko.lifnr
    counter_3.counterparty_full_name                                                                                                                               as supplier_name, -- MM.000273
    coalesce(ekko_1_1.purchase_group_code, ekko_1_2.purchase_group_code, ekko_1_3.purchase_group_code)                                                             as purchase_responsible_department_code, -- MM.000286
    coalesce(ekko_1_1.number_of_principal_purchase_agreement, ekko_1_3.number_of_principal_purchase_order)                                                         as purchase_contract_code, -- MM.000290
    coalesce(ekko_2_1.purchase_contract_external_part1_number, ekko_2_2.purchase_contract_external_part1_number, ekko_2_3.purchase_contract_external_part1_number) as purchase_contract_name, -- MM.000291
    coalesce(ekko_2_1.dt_purchase_agreement, ekko_2_2.dt_purchase_contract, ekko_2_3.dt_purchase_order)                                                            as dt_purchase_contract, -- MM.000292
    counter_2.counterparty_full_name                                                                                                                               as agent_name, -- MM.000305
    (case when ekbe.debit_or_credit_code = 'S' then ekbe.document_currency_amount else -ekbe.document_currency_amount end) * vrt.vat_rate                          as vat_document_currency_amount, -- MM.000267
    coalesce(case when ekbe.debit_or_credit_code = 'S' then ekbe.document_currency_amount else -ekbe.document_currency_amount end, 0)
    + coalesce((case when ekbe.debit_or_credit_code = 'S' then ekbe.document_currency_amount else -ekbe.document_currency_amount end) * vrt.vat_rate, 0)           as document_currency_total_amount,  -- MM.000268
    case when ekbe.general_ledger_account_clearing_amount <> 0 then bkpf_3.accounting_document_code end                                                            as accounting_receipt_document_code, -- MM.000275
    mseg.dt_posting                                                                                                                                                as dt_material_document_posting, -- MM.000277
    mseg.dt_material_movement_document                                                                                                                             as dt_material_document, -- MM.000278
    mate.material_name, -- MM.000283
    pugr.purchase_group_name                                                                                                                                       as purchase_responsible_department_name, -- MM.000287
    glas_2.general_ledger_account_code, --MM.000288
    coalesce(toro.order_short_name, prod.order_short_name, contr.order_short_name)                                                                                 as order_name, -- MM.000296
    wemdd.wbs_element_number, -- MM.000958
    wemdd.wbs_element_short_name                                                                                                                                   as wbs_element_name, -- MM.000298
    mat_batch.transport_bill_code                                                                                                                                  as railway_bill_number, -- MM.000301
    case when mmde.material_movement_document_uom_code is not null and mmde.material_movement_document_quantity is not null then 'X' end                           as is_material_form_006_exist, -- MM.000306
    mmde.material_movement_document_quantity                                                                                                                       as material_form_006_quantity, -- MM.000307
    mmde.material_movement_document_uom_code                                                                                                                       as material_form_006_uom_code, -- MM.000308
    cct.cost_center_short_name                                                                                                                                     as cost_center_name, -- MM.000294
    coalesce(ekpo_1.incoterms_code, ekpo_2.incoterms_code, ekpo_3.incoterms_code, ekko_1_1.incoterms_code, ekko_1_2.incoterms_code, ekko_1_3.incoterms_code)       as incoterms_code, -- MM.000302
    pst.plant_short_name                                                                                                                                           as plant_name, -- T001W-NAME1
    coalesce(ekko_1_1.purchase_organization_code, ekko_1_2.purchase_organization_code, ekko_1_3.purchase_organization_code)                                        as purchase_organization_code, -- EKKO-EKORG
    pot.purchase_organization_name, -- T024E-EKOTX
    coalesce(ekpo_1.uom_code, ekpo_2.uom_code, ekpo_3.uom_code)                                                                                                    as purchase_order_uom_code, -- EKPO-MEINS
    ueft.uom_external_format_code                                                                                                                                  as purchase_order_uom_name, -- T006A-MSEH3
    ekko_1_3.legal_agreement_number, -- EKKO-ZURDOG
    ekko_1_3.paydox_registration_number                                                                                                                            as paydox_purchase_document_registration_number, -- EKKO-ZZIHREZ
    ekko_2_2.budget_type_code, -- EKKO-ZZBIZP
    btt.budget_type_name, -- DD07T-DDTEXT
    ekko_1_3.unified_purchase_contract_code, -- EKKO-ZZUNIDOC
    coalesce(ekko_1_3.paydox_document_url, ppd.paydox_document_url)                                                                                                as paydox_document_url,
    ltrim(base.material_code, '0')                                                                                                                                 as material_truncated_code, --Преобразовать MM.000282 с обрезанными лидирующими нулями (для проверки: из значения ‘000000000014002556’ должно получиться ‘14002556’).
    right(base.material_code, 14)                                                                                                                                  as material_trimmed_code, -- Преобразовать MM.000282 с обрезанными слева символами (для проверки: из значения ‘000000000014002556’ должно получиться ‘00000014002556’).
    ltrim(base.material_code, '0') || ' ' || mate.material_name                                                                                                    as material_search_name, -- MM.000751 + MM.000283
    ltrim(base.payee_alternative_code, '0')                                                                                                                        as counterparty_truncated_code, -- Преобразовать MM.000269 с обрезанными лидирующими нулями (для проверки: из значения ‘0000002556’ должно получиться ‘2556’).
    ltrim(base.payee_alternative_code, '0') || ' ' || counter.counterparty_full_name                                                                               as counterparty_search_name, -- MM.000754 + MM.000270
    case
        when coalesce(ekpo_1.is_purchase_export_market_code, ekpo_2.is_purchase_export_market_code, ekpo_3.is_purchase_export_market_code) = 'X' then 'Импорт' -- ZZIMPORT
        when coalesce(ekpo_1.is_purchase_customs_union_eeu_code, ekpo_2.is_purchase_customs_union_eeu_code, ekpo_3.is_purchase_customs_union_eeu_code) = 'X' then 'Таможенный союз' -- ZZTAMOZHSOUS
        when coalesce(ekpo_1.is_purchase_domestic_market_code, ekpo_2.is_purchase_domestic_market_code, ekpo_3.is_purchase_domestic_market_code) = 'X' then 'Внутренний рынок' -- ZZINTMARKET
        else 'Не определено'
    end                                                                                                                                                            as purchase_type_name, -- Для EKPO-EBELN ключ = MM.000355, EKPO-EBELP ключ = MM.000457.
    ekkn.sales_document_code, -- для EKKN-EBELN ключ = MM.000279, EKKN-EBELP ключ = MM.000280
    ekkn.sales_document_position_code, -- для EKKN-EBELN ключ = MM.000279, EKKN-EBELP ключ = MM.000280
    coalesce(mtprod_1.material_name, mtprod_2.material_name, mtprod_3.material_name)                                                                               as producer_material_name, -- MM.001025
    unb.currency_code                                                                                                                                              as unit_balance_currency_code, -- MM.001026
    case
        when case when ekbe.debit_or_credit_code = 'S' then ekbe.quantity else -ekbe.quantity end = 0 then 0
        else
            case when ekbe.debit_or_credit_code = 'S' then ekbe.local_currency_amount else -ekbe.local_currency_amount end
            / case when ekbe.debit_or_credit_code = 'S' then ekbe.quantity else -ekbe.quantity end
    end                                                                                                                                                            as material_price_local_currency_amount,    -- MM.001027
    coalesce(ekko_1_1.currency_code, ekko_1_2.currency_code, ekko_1_3.currency_code)                                                                               as purchase_document_currency_code,  -- MM.001028
    case
        when base.document_to_local_currency_exchange_rate < 0 then '/' || abs(base.document_to_local_currency_exchange_rate)::varchar
        when base.document_to_local_currency_exchange_rate > 0 then ' ' || abs(base.document_to_local_currency_exchange_rate)::varchar
    end                                                                                                                                                            as document_currency_to_local_currency_exchange_rate,   -- MM.001029
    mat.material_category_code                                                                                                                                     as material_category_level4_code,   -- MM.001030
    mctxt_lvl4.material_category_name                                                                                                                              as material_category_level4_name,   -- MM.001031
    mc_lvl3.material_grand_category_code                                                                                                                           as material_category_level3_code,   -- MM.001032
    mctxt_lvl3.material_category_name                                                                                                                              as material_category_level3_name,      -- MM.001033
    mc_lvl2.material_grand_category_code                                                                                                                           as material_category_level2_code,   -- MM.001034
    mctxt_lvl2.material_category_name                                                                                                                              as material_category_level2_name,      -- MM.001035
    mc_lvl1.material_grand_category_code                                                                                                                           as material_category_level1_code,   -- MM.001036
    mctxt_lvl1.material_category_name                                                                                                                              as material_category_level1_name,      -- MM.001037
    coalesce(ekko_1_1.dt_valid_from, ekko_1_2.dt_valid_from, ekko_1_3.dt_valid_from)                                                                               as dt_purchase_document_valid_from,  -- MM.001038
    coalesce(ekko_1_1.dt_valid_to, ekko_1_2.dt_valid_to, ekko_1_3.dt_valid_to)                                                                                     as dt_purchase_document_valid_to,          -- MM.001039
    coalesce(ekko_1_1.dt_purchase_agreement, ekko_1_2.dt_purchase_contract, ekko_1_3.dt_purchase_order)                                                            as dt_purchase_document,         -- MM.001040
    mseg.dt_created::date                                                                                                                                          as dt_material_document_created,   -- MM.001041
    coalesce(ekko_1_1.terms_of_payment_code, ekko_1_2.terms_of_payment_code, ekko_1_3.terms_of_payment_code)                                                       as terms_of_payment_code,  -- MM.001042
    tp_txt.terms_of_payment_name,      -- MM.001043
    coalesce(ekpo_1.incoterms_location_code, ekpo_2.incoterms_location_code, ekpo_3.incoterms_location_code)                                                       as purchase_document_incoterms_location_code,  -- MM.001044
    th_inco_txt.transport_hub_name                                                                                                                                 as purchase_document_incoterms_location_name,    -- MM.001045
    trs.transport_route_stage_departure_hub_code                                                                                                                   as transport_departure_hub_code,   -- MM.001046
    th_dep_txt.transport_hub_name                                                                                                                                  as transport_departure_hub_name,                  -- MM.001047
    mat.material_group_code,			    -- MM.001048
    mg_txt.material_group_short_name, -- MM.001049
    concat_ws(' ', mat.material_group_code, mg_txt.material_group_short_name)                                                                                      as material_group_search_name,  -- MM.001050
    concat_ws(' ', mat.material_category_code, mctxt_lvl4.material_category_name)                                                                                  as material_category_search_name   -- MM.001051
from invoice_purchase_document                                                                                                                                     as base
left join dm_calc.accounting_document_header_for_purchase_documents                                                                                                as bkpf
    on
        bkpf.unit_balance_code = base.unit_balance_code
        and bkpf.fiscal_year = base.fiscal_year
        and bkpf.dt_posting = base.dt_posting
        and bkpf.accounting_document_type = base.purchase_document_type_code
        and bkpf.reference_object_key = concat(base.invoice_code, base.fiscal_year)
left join dm_calc.accounting_document_header_for_purchase_documents                                                                                                as bkpf_2
    on
        bkpf_2.unit_balance_code = base.unit_balance_code
        and bkpf_2.accounting_document_code = bkpf.accounting_document_code
        and bkpf_2.fiscal_year = base.fiscal_year
left join dds.accounting_documents                                                                                                                                 as bseg
    on
        bseg.unit_balance_code = base.unit_balance_code
        and bseg.accounting_document_code = bkpf.accounting_document_code
        and bseg.fiscal_year::text = bkpf.fiscal_year
        and bseg.account_type = 'K'
        and bseg.is_active = true
left join dict_dds.general_ledger_account_standard                                                                                                                 as glas
    on
        glas.valuation_class_code = base.valuation_class_code
        and glas.account_modification_code is null
        and glas.valuation_group_code = '5101'
        and glas.transaction_key_code = 'WRX'
        and glas.account_chart_code = '1000'
left join dds.purchase_document_position_invoice_assignment                                                                                                        as rbco
    on
        rbco.accounting_document_code = base.invoice_code
        and rbco.fiscal_year = base.fiscal_year
        and rbco.accounting_document_position_code = base.invoice_position_line_item_code
left join dict_dds.counterparty                                                                                                                                    as counter
    on counter.counterparty_code = base.payee_alternative_code
left join dict_dds.counterparty                                                                                                                                    as counter_2
    on counter_2.counterparty_code = base.creditor_agent_code
left join dds.purchase_agreement_header                                                                                                                            as ekko_1_1 -- EKKO-EBELN ключ = MM.000279
    on ekko_1_1.purchase_agreement_code = base.purchase_document_code
left join dds.purchase_contract_header                                                                                                                             as ekko_1_2
    on ekko_1_2.purchase_contract_code = base.purchase_document_code
left join dds.purchase_order_header                                                                                                                                as ekko_1_3
    on ekko_1_3.purchase_order_code = base.purchase_document_code
left join dict_dds.counterparty                                                                                                                                    as counter_3
    on counter_3.counterparty_code = coalesce(ekko_1_1.supplier_code, ekko_1_2.supplier_code, ekko_1_3.supplier_code)
left join dds.purchase_agreement_header                                                                                                                            as ekko_2_1 -- EKKO-EBELN ключ = MM.000290
    on ekko_2_1.purchase_agreement_code = coalesce(ekko_1_1.number_of_principal_purchase_agreement, ekko_1_3.number_of_principal_purchase_order)
left join dds.purchase_contract_header                                                                                                                             as ekko_2_2 on ekko_2_2.purchase_contract_code = coalesce(ekko_1_1.number_of_principal_purchase_agreement, ekko_1_3.number_of_principal_purchase_order)
left join dds.purchase_order_header                                                                                                                                as ekko_2_3 on ekko_2_3.purchase_order_code = coalesce(ekko_1_1.number_of_principal_purchase_agreement, ekko_1_3.number_of_principal_purchase_order)
left join dds.purchase_agreement_position                                                                                                                          as ekpo_1 on ekpo_1.purchase_agreement_code = base.purchase_document_code and ekpo_1.position_line_item_code = base.purchase_document_position_line_item_code
left join dds.purchase_contract_position                                                                                                                           as ekpo_2 on ekpo_2.purchase_contract_code = base.purchase_document_code and ekpo_2.position_line_item_code = base.purchase_document_position_line_item_code
left join dds.purchase_order_position                                                                                                                              as ekpo_3 on ekpo_3.purchase_order_code = base.purchase_document_code and ekpo_3.position_line_item_code = base.purchase_document_position_line_item_code
left join dict_dds.material_texts                                                                                                                                  as mtprod_1 on mtprod_1.material_code = ekpo_1.material_main_code and mtprod_1.language_code = 'R'
left join dict_dds.material_texts                                                                                                                                  as mtprod_2 on mtprod_2.material_code = ekpo_2.material_main_code and mtprod_2.language_code = 'R'
left join dict_dds.material_texts                                                                                                                                  as mtprod_3 on mtprod_3.material_code = ekpo_3.material_main_code and mtprod_3.language_code = 'R'
left join dds.purchase_document_history                                                                                                                            as ekbe
    on
        ekbe.purchase_document_code = base.purchase_document_code and ekbe.purchase_document_position_code = base.purchase_document_position_line_item_code
        and ekbe.material_document_code = base.invoice_code and ekbe.fiscal_year = base.fiscal_year and ekbe.material_document_position_code = substring(base.invoice_position_line_item_code, 3, 4)
        and ekbe.assignment_code = base.assignment_code
left join dict_dds.unit_balance                                                                                                                                    as unb on unb.unit_balance_code = base.unit_balance_code
left join dict_dds.country                                                                                                                                         as country on country.country_code = unb.country_code
left join dict_dds.vat_rates_texts                                                                                                                                 as vrt
    on
        vrt.calculation_scheme_code = country.calculation_scheme_code and vrt.vat_code = coalesce(rbco.vat_code, base.vat_tax_code)
        and vrt.language_code = 'R'
left join dds.material_movement_document                                                                                                                           as mseg
    on
        mseg.material_movement_document_code = ekbe.reference_document_code and mseg.material_movement_document_year = ekbe.reference_document_fiscal_year
        and mseg.material_movement_document_position_code = ekbe.reference_document_position_code
left join fi_data                                                                                                                                                  as bkpf_3
    on
        bkpf_3.unit_balance_code = base.unit_balance_code
        and bkpf_3.fiscal_year = ekbe.reference_document_fiscal_year
        and bkpf_3.dt_posting = mseg.dt_posting
        and bkpf_3.accounting_document_type = mseg.material_movement_document_type_code
        and bkpf_3.accounting_document_status_code is null
        and bkpf_3.reference_object_key = ekbe.reference_document_code || ekbe.reference_document_fiscal_year
left join dict_dds.material_texts                                                                                                                                  as mate on mate.material_code = base.material_code and mate.language_code = 'R'
left join dict_dds.purchase_group                                                                                                                                  as pugr on pugr.purchase_group_code = coalesce(ekko_1_1.purchase_group_code, ekko_1_2.purchase_group_code, ekko_1_3.purchase_group_code)
left join dict_dds.general_ledger_account_standard                                                                                                                 as glas_2
    on
        glas_2.valuation_class_code = base.valuation_class_code and glas_2.account_chart_code = '1000'
        and glas_2.transaction_key_code = 'BSX' and glas_2.valuation_group_code = '5101'
left join dict_dds.order_toro                                                                                                                                      as toro on toro.order_code = rbco.order_code
left join dict_dds.order_production                                                                                                                                as prod on prod.order_code = rbco.order_code
left join dict_dds.order_controlling                                                                                                                               as contr on contr.order_code = rbco.order_code
left join dds.purchase_document_expense_assignment                                                                                                                 as ekkn
    on
        base.purchase_document_code = ekkn.purchase_document_code
        and base.purchase_document_position_line_item_code = ekkn.purchase_document_line_item_code
        and base.assignment_code = ekkn.expense_assignment_code
left join dict_dds.wbs_element_master_data_detail                                                                                                                  as wemdd -- PRPS
    on wemdd.wbs_element_code = coalesce(rbco.wbs_element_code, ekkn.wbs_element_code)
left join dict_dds.material_movement_document_extended                                                                                                             as mmde
    on
        mmde.material_movement_document_code = ekbe.reference_document_code
        and mmde.material_movement_document_year = ekbe.reference_document_fiscal_year and mmde.material_movement_document_position_code = ekbe.reference_document_position_code
left join dds.material_batch                                                                                                                                       as mat_batch on mat_batch.material_code = mseg.material_code and mat_batch.batch_code = mseg.batch_code
left join dict_dds.cost_center_texts                                                                                                                               as cct on cct.cost_center_code = rbco.cost_center_code and cct.language_code = 'R' and cct.dt_valid_to = '2299-12-31'
left join dm_calc.accounting_document_tax_classification                                                                                                           as bseg_2
    on
        bseg_2.general_ledger_account_code = rbco.general_ledger_account_code
        and bseg_2.unit_balance_code = base.unit_balance_code and bseg_2.accounting_document_code = bkpf.accounting_document_code and bseg_2.fiscal_year = base.fiscal_year
left join dm_calc.accounting_document_tax_classification                                                                                                           as bseg_3
    on
        bseg_3.general_ledger_account_code = rbco.general_ledger_account_code
        and bseg_3.unit_balance_code = base.unit_balance_code
        and bseg_3.accounting_document_code = case when ekbe.general_ledger_account_clearing_amount <> 0 then bkpf_3.accounting_document_code end
        and bseg_3.fiscal_year = date_part('year', mseg.dt_posting)::text
left join material_batch                                                                                                                                           as for_300 on for_300.material_code = mseg.material_code and for_300.plant_code = mseg.plant_code and for_300.batch_code = mseg.batch_code
left join customs_declaration                                                                                                                                      as zgtd
    on
        zgtd.material_movement_document_code = ekbe.reference_document_code
        and zgtd.material_movement_document_year = ekbe.reference_document_fiscal_year
        and zgtd.material_movement_document_position_code = ekbe.reference_document_position_code
left join dict_dds.plant_and_subsidiary_texts                                                                                                                      as pst
    on
        pst.plant_code = base.plant_code -- T001W-WERKS ключ = MM.000281
        and pst.language_code = 'R'
left join dict_dds.purchase_organization_texts                                                                                                                     as pot
    on pot.purchase_organization_code = coalesce(ekko_1_1.purchase_organization_code, ekko_1_2.purchase_organization_code, ekko_1_3.purchase_organization_code) -- T024E-EKORG ключ = MM.000741
left join dict_dds.uom_external_format_texts                                                                                                                       as ueft
    on
        ueft.uom_code = coalesce(ekpo_1.uom_code, ekpo_2.uom_code, ekpo_3.uom_code) -- T006A-MSEHI ключ = MM.000743
        and ueft.language_code = 'R' -- T006A-SPRAS = SY-SPRAS
left join dict_dds.budget_type_texts                                                                                                                               as btt
    on
        btt.budget_type_code = ekko_2_2.budget_type_code -- DD07T-DOMNAME ключ = /RUSAL/ZZBIZP, DD07T-DOMVALUE_L = MM.000747
        and btt.language_code = 'R' -- DD07T-DDLANGUAGE ключ = SY-DDLANGUAGE
left join dds.paydox_purchase_document_draft_header                                                                                                                as ppd
    on
        ppd.purchase_contract_code = coalesce(ekko_1_1.number_of_principal_purchase_agreement, ekko_1_3.number_of_principal_purchase_order) -- /RUSAL/PDX_H-KONNR = MM.000290
        and ppd.paydox_purchase_document_draft_code = ekko_2_3.purchase_order_draft_code --/RUSAL/PDX_H-ID = EKKO-ZZTEMPID для EKKO-EBELN ключ = MM.000290,
        and ppd.paydox_purchase_document_draft_type_code = '1' -- при /RUSAL/PDX_H-ID_TYPE = 1
left join dict_dds.material                                                                                                                                        as mat
    on mat.material_code = base.material_code
left join dict_dds.material_group_texts                                                                                                                            as mg_txt
    on
        mg_txt.material_group_code = mat.material_group_code
        and mg_txt.language_code = 'R'
left join dict_dds.material_category_main_data_texts                                                                                                               as mctxt_lvl4
    on
        mctxt_lvl4.material_category_code = mat.material_category_code
        and mctxt_lvl4.language_code = 'R'
left join dict_dds.material_category_main_data                                                                                                                     as mc_lvl3
    on mc_lvl3.material_category_code = mat.material_category_code
left join dict_dds.material_category_main_data_texts                                                                                                               as mctxt_lvl3
    on
        mctxt_lvl3.material_category_code = mc_lvl3.material_grand_category_code
        and mctxt_lvl3.language_code = 'R'
left join dict_dds.material_category_main_data                                                                                                                     as mc_lvl2
    on mc_lvl2.material_category_code = mc_lvl3.material_grand_category_code
left join dict_dds.material_category_main_data_texts                                                                                                               as mctxt_lvl2
    on
        mctxt_lvl2.material_category_code = mc_lvl3.material_grand_category_code
        and mctxt_lvl2.language_code = 'R'
left join dict_dds.material_category_main_data                                                                                                                     as mc_lvl1
    on mc_lvl1.material_category_code = mc_lvl2.material_grand_category_code
left join dict_dds.material_category_main_data_texts                                                                                                               as mctxt_lvl1
    on
        mctxt_lvl1.material_category_code = mc_lvl2.material_grand_category_code
        and mctxt_lvl1.language_code = 'R'
left join dict_dds.terms_of_payment_texts                                                                                                                          as tp_txt
    on
        tp_txt.terms_of_payment_code = coalesce(ekko_1_1.terms_of_payment_code, ekko_1_2.terms_of_payment_code, ekko_1_3.terms_of_payment_code)
        and tp_txt.language_code = 'R'
left join dict_dds.transport_hub_texts                                                                                                                             as th_inco_txt
    on
        th_inco_txt.transport_hub_code = coalesce(ekpo_1.incoterms_location_code, ekpo_2.incoterms_location_code, ekpo_3.incoterms_location_code)
        and th_inco_txt.language_code = 'R'
left join dict_dds.transport_route_stage                                                                                                                           as trs
    on
        trs.transport_route_code = coalesce(ekpo_1.route_code, ekpo_2.route_code, ekpo_3.route_code)
        and trs.transport_route_stage_number = '0001'
left join dict_dds.transport_hub_texts                                                                                                                             as th_dep_txt
    on
        th_dep_txt.transport_hub_code = trs.transport_route_stage_departure_hub_code
        and th_dep_txt.language_code = 'R';

