VITE_API_BASE_URL=
VITE_AUTH_ENABLED=true
CLICK_META_DIR=config_files/meta
DEV_CLICK_META_DIR=config_files/meta_dev
DEV_DATABASE_URL=
AIRFLOW_DEV_BASE_URL=
AIRFLOW_DEV_DAG_ID=
AIRFLOW_DEV_USERNAME=
AIRFLOW_DEV_PASSWORD=
