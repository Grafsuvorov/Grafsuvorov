-- ограничение на тип контировки
drop table if exists knttp_params;
create temporary table knttp_params as (
    select range_low_value
    from dict_dds.settings_and_parameters_sap
    where
        abap_program_code = '/RUSAL/MM1735M'
        and parameter_code = 'S_KNTTP'
        and range_low_value is not null
)
distributed replicated;

-- выборка партий товаров
drop table if exists material_batch;
create temporary table material_batch as
(
    select
        material_code,
        plant_code,
        batch_code,
        material_movement_document_header_text
    from (
        select
            material_code,
            plant_code,
            batch_code,
            material_movement_document_header_text,
            row_number() over (
                partition by
                    material_code,
                    plant_code,
                    batch_code
                order by
                    material_movement_document_code,
                    material_movement_document_year
            ) as rn
        from dds.material_movement_document
        where movement_type_code = (
            select range_low_value
            from dict_dds.settings_and_parameters_sap
            where
                abap_program_code = '/RUSAL/SD4012M'
                and parameter_code = 'BWART'
        )
        and is_cancelled_document_code is null
    ) as sq
    where rn = 1
)
distributed by (material_code, plant_code, batch_code);




-- данные финансовых документов
drop table if exists fi_data;
create temporary table fi_data as (
    select
        unit_balance_code,
        fiscal_year,
        dt_posting,
        accounting_document_type,
        accounting_document_status_code,
        reference_object_key,
        accounting_document_code,
        dt_accounting_document
    from (
        select
            unit_balance_code,
            fiscal_year,
            dt_posting,
            accounting_document_type,
            accounting_document_status_code,
            reference_object_key,
            accounting_document_code,
            dt_accounting_document,
            row_number() over (partition by
                unit_balance_code,
                fiscal_year,
                dt_posting,
                accounting_document_type,
                accounting_document_status_code,
                reference_object_key
            order by accounting_document_code) as rn
        from dm_calc.accounting_document_header_for_purchase_documents
    ) as sq
    where rn = 1
)
distributed by (unit_balance_code, fiscal_year, dt_posting);

-- выборка деклараций ГТД в привязке к документу движения товара
drop table if exists customs_declaration;
create temporary table customs_declaration as (
    select
        material_movement_document_code,
        material_movement_document_year,
        material_movement_document_position_code,
        customs_declaration_external_number
    from (
        select
            cdp.material_movement_document_code,
            cdp.material_movement_document_year,
            cdp.material_movement_document_position_code,
            cdh.customs_declaration_external_number,
            row_number() over (partition by
                cdp.material_movement_document_code,
                cdp.material_movement_document_year,
                cdp.material_movement_document_position_code
            order by cdh.dt_customs_declaration desc) as rn
        from dds.customs_declaration_position as cdp
        left join dds.customs_declaration_header as cdh
            on
                cdh.plant_code = cdp.plant_code
                and cdh.fiscal_year = cdp.fiscal_year
                and cdh.customs_declaration_code = cdp.customs_declaration_code
                and cdh.customs_declaration_type_code not in (
                    select range_low_value
                    from dict_dds.settings_and_parameters_sap
                    where
                        abap_program_code = '/RUSAL/MM589M_POTOK_MM'
                        and parameter_code = 'G0131_EX'
                        and range_low_value is not null
                )
        where cdp.is_deleted_code is null
    ) as sq
    where rn = 1
)
distributed by (material_movement_document_code, material_movement_document_year, material_movement_document_position_code);

-- базовая выборка с глобальными фильтрами
drop table if exists invoice_purchase_document;
create temporary table invoice_purchase_document as (
    select
        hdr.invoice_code,
        hdr.fiscal_year,
        hdr.unit_balance_code,
        hdr.purchase_document_type_code,
        hdr.dt_purchase_document,
        hdr.dt_posting,
        hdr.invoice_currency_code,
        hdr.payee_alternative_code,
        hdr.invoice_position_line_item_text,
        hdr.customs_declaration_number,
        hdr.invoice_of_supplier_agent_code,
        hdr.creditor_agent_code,
        hdr.document_to_local_currency_exchange_rate,
        pos.invoice_position_line_item_code,
        pos.assignment_code,
        pos.debit_or_credit_code,
        pos.reference_document_number,
        pos.purchase_document_code,
        pos.purchase_document_position_line_item_code,
        pos.plant_code,
        pos.material_code,
        pos.valuation_type_code,
        pos.valuation_class_code,
        pos.vat_tax_code
    from dds.invoice_purchase_document_header as hdr
    left join dds.invoice_purchase_document_position as pos
        on
            pos.invoice_code = hdr.invoice_code
            and pos.fiscal_year = hdr.fiscal_year
    where
        pos.material_code is not null
        and hdr.fiscal_year::int >= 2021 -- Ограничение на ПМ
        and hdr.invoice_status_code <> '2'
)
distributed by (invoice_code, invoice_position_line_item_code, fiscal_year);

